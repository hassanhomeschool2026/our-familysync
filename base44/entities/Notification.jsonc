{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Recipient user ID"
    },
    "type": {
      "type": "string",
      "enum": [
        "event_reminder",
        "task_due",
        "family_alert",
        "checkin",
        "general"
      ],
      "description": "Notification type"
    },
    "message": {
      "type": "string",
      "description": "Notification message"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "type",
    "message"
  ]
}